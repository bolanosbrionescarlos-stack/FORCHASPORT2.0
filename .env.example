# Variables de entorno para FORCHA SPORT

# URL y clave pública de Supabase (pueden ir en el navegador)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-aqui

# Clave secreta de Supabase (solo en el servidor, NUNCA en el cliente)
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-aqui

# Configuración del proveedor de pagos
# Para Perú, recomendamos Mercado Pago
PAYMENT_PROVIDER=mercado_pago
# Clave secreta de Mercado Pago (entorno de producción)
MERCADO_PAGO_SECRET_KEY=tu-secret-key-aqui
# Clave pública de Mercado Pago (para el checkout del lado del cliente)
MERCADO_PAGO_PUBLIC_KEY=tu-public-key-aqui
# Webhook secret para verificar notificaciones de Mercado Pago
MERCADO_PAGO_WEBHOOK_SECRET=tu-webhook-secret-aqui

# Configuración de correo electrónico (opcional, para confirmaciones de pedido)
# Si no configurarás un proveedor de correo, las confirmaciones se mostrarán en pantalla
EMAIL_PROVIDER_API_KEY=tu-api-key-aqui
EMAIL_FROM=noreply@forchasport.com

# Configuración de la tienda
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CURRENCY=PEN
NEXT_PUBLIC_COUNTRY=PE

# Configuración adicional
NODE_ENV=development